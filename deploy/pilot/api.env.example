NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=4000
API_DOCS_ENABLED=off
API_CORS_ORIGINS=http://tauri.localhost,https://tauri.localhost,tauri://localhost
DATABASE_URL=postgresql://lcit_app:REPLACE_ME@192.168.251.126:5432/lcit_manager?sslmode=verify-full&sslrootcert=/etc/lcit-manager/postgres-ca.crt
ATTACHMENTS_DIR=/var/lib/lcit-manager/attachments
ATTACHMENT_MAX_BYTES=20971520
ATTACHMENT_PENDING_TTL_MINUTES=60
MONITORING_ENABLED=on
MONITORING_TIME_ZONE=Asia/Ho_Chi_Minh
MONITORING_EXPIRY_CRON="0 0 2 * * *"
MONITORING_DNS_TLS_CRON="0 */30 * * * *"
MONITORING_ALLOWED_HOSTS=
MONITORING_ALLOWED_CIDRS=
MONITORING_ALLOWED_TLS_PORTS=443
MONITORING_CHECK_TIMEOUT_MS=5000
MONITORING_CHECK_CONCURRENCY=4
