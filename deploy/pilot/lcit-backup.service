[Unit]
Description=LCIT paired database and attachment backup
Wants=network-online.target
After=network-online.target lcit-api.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/lcit-manager/backup.env
ExecStart=/bin/bash /opt/lcit-manager/deploy/pilot/backup.sh
TimeoutStartSec=1h
UMask=0077
StandardOutput=journal
StandardError=journal
