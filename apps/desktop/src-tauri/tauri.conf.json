{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LCIT Manager",
  "version": "0.1.0",
  "identifier": "vn.lcit.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [{ "label": "main", "title": "LCIT Manager", "width": 900, "height": 620 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:4000 http://localhost:4000 https:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico"]
  }
}
