{
  "name": "@lcit/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "test:sftp": "npm run build && node --test --test-concurrency=1 test/sftp.test.cjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test:t43": "npm run build && node scripts/test-system.cjs",
    "recovery": "node scripts/recovery.cjs",
    "test:t44": "npm run build && node --test --test-concurrency=1 test/phase4-operations.test.cjs",
    "test": "npm run build && node --test --test-concurrency=1 test/phase1.test.cjs test/phase2-attachments.test.cjs test/phase2-imports.test.cjs test/phase3-monitoring.test.cjs test/phase3-expiry.test.cjs test/phase3-network.test.cjs test/phase3-notifications.test.cjs test/phase3-reports.test.cjs test/phase4-access.test.cjs test/phase4-system.test.cjs test/phase4-performance.test.cjs test/sftp.test.cjs",
    "dev": "npm run build && npm start",
    "start": "node --env-file-if-exists=.env.example --env-file-if-exists=.env.local dist/main.js",
    "db:migrate": "npm run build && node --env-file-if-exists=.env.example --env-file-if-exists=.env.local --env-file-if-exists=.env.migrate.local dist/migrate.js",
    "db:seed": "npm run build && node --env-file-if-exists=.env.example --env-file-if-exists=.env.local dist/seed.js",
    "db:bootstrap-admin": "npm run build && node --env-file-if-exists=.env.example --env-file-if-exists=.env.local dist/bootstrap-admin.js",
    "attachments:cleanup": "npm run build && node --env-file-if-exists=.env.example --env-file-if-exists=.env.local dist/attachments-cleanup.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.0",
    "cron": "^4.4.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "ipaddr.js": "^1.9.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ssh2-sftp-client": "^12.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "typescript": "~5.9.3"
  }
}
