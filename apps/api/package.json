{
  "name": "@lcit/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/phase1.test.cjs",
    "dev": "npm run build && npm start",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/main.js",
    "db:migrate": "npm run build && node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/migrate.js",
    "db:seed": "npm run build && node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/seed.js",
    "db:bootstrap-admin": "npm run build && node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/bootstrap-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "~5.9.3"
  }
}
